// How the app is served: static files and nothing else. There is no backend
// anywhere in this project, so there is no Worker script here either — only the
// directory vite writes, handed to the host to serve at the root of its name.
{
  "name": "choai",
  "compatibility_date": "2026-08-15",
  "assets": {
    "directory": "./dist",
    // Every route is drawn by the router in the page, so a path that is not a
    // file is not a missing page — it is the app, asked for somewhere other
    // than its front door.
    //
    // This is the only place to say it. A _redirects rule sending /* to
    // /index.html is refused before it is ever served: paths are normalised
    // before they are matched, `/index` is what normalising strips, and so a
    // rule pointing at /index.html reads as a rule that triggers itself.
    "not_found_handling": "single-page-application"
  }
}
