# Copy to .env to override. Neither of these is a secret: both end up in the
# page as built. Without any .env at all, `npm run dev` links to the app on
# this machine and `npm run build` links to the published one.

# Where the app itself is.
PUBLIC_APP=https://choai.dev

# Cloudflare Web Analytics. Empty, or absent, means no counter is written into
# the page at all. The token is served to every visitor, so it is not private.
PUBLIC_CF_BEACON=
