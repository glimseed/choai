# Settings that end up in the page, so nothing secret belongs here. Anything
# private goes in .env.local, which is not committed.

# Where the app itself is. Overridden for development, so that a page built
# here in anger links to the published app rather than to a laptop.
PUBLIC_APP=https://hledger-pwa.dev

# Cloudflare Web Analytics. Empty means no counter is written into the page at
# all; the token is not a secret, it is served to every visitor.
PUBLIC_CF_BEACON=
