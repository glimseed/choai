---
/**
 * A page that is read: one column, headings, and a way on at the end.
 *
 * The terms, the privacy notice and every page explaining how something works
 * share this — they are the same thing on paper, and giving each its own
 * renderer would only mean three places to fix a heading.
 *
 * The date is shown where there is one. The terms carry one because somebody
 * checking them is checking whether they changed; a page about how the app
 * works does not, since it is either true or wrong and a date on it only
 * invites reading age as staleness.
 */
import Shell from "./Shell.astro"
import type { Document } from "./document"
import { READINGS, same } from "./paths"
import type { Words } from "./words"

interface Props {
  words: Words
  document: Document
  /** Without the language on the front, so this page can leave itself out below. */
  here: string
}

const { words, document, here } = Astro.props
const ja = words.lang === "ja"
const at = (path: string): string => (ja ? `/ja${path}` : path)

/** Everywhere else worth going, this page excepted. */
const onwards = READINGS.filter((reading) => !same(reading.path, here))
---

<Shell words={words} heading={document.title}>
  <article>
    <h1>{document.title}</h1>
    {document.updated && <p class="updated">{document.updated}</p>}
    <p class="intro">{document.intro}</p>
    {
      document.sections.map((section) => (
        <>
          <h2>{section.heading}</h2>
          {section.body.map((line) => (
            <p>{line}</p>
          ))}
          {section.links && (
            <p class="links">
              {section.links.map((link) => (
                <a href={link.href} rel={link.href.startsWith("/") ? null : "noreferrer"}>
                  {link.label} →
                </a>
              ))}
            </p>
          )}
        </>
      ))
    }

    {/* Every other page, from the one table, so a page added is a page linked
        from everywhere without anybody remembering to. */}
    <nav class="more">
      {onwards.map((reading) => (
        <a href={at(reading.path)}>{(ja ? reading.ja : reading.en).title} →</a>
      ))}
    </nav>
  </article>
</Shell>
