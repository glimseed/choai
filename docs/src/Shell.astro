---
/**
 * Everything every page here has: the head, the look, the way to the other
 * language, and the footer.
 *
 * Styles are inline, there are no fonts to fetch, and nothing written here
 * reaches off the page at all. Visits are counted by the host on the way out,
 * which puts its own counter into a name it is already serving — so a counter
 * written in here as well would be the same visit counted twice, and there is
 * nothing in this file to keep in step with it.
 */
import type { Words } from "./words"
import "./site.css"

interface Props {
  words: Words
  /** Named for pages that are not the front one; it goes before the app's name. */
  heading?: string
}

const { words, heading } = Astro.props

/** Where all of this is, app and site together, for anyone who wants to read it
 * or run their own. */
const SOURCE = "https://github.com/mrksye/choai"
const ja = words.lang === "ja"

/**
 * The same page without its language on the front.
 *
 * Matched as a whole segment rather than as the letters at the start: a page
 * called `/japan-and-tax` begins with the same two letters as the Japanese of
 * everything, and stripping them by spelling would send a reader to
 * `/pan-and-tax`. Nothing here is called that today, which is exactly the sort
 * of thing that stays true until it does not.
 */
const here = Astro.url.pathname
const inEnglish = here.replace(/^\/ja(?=\/|$)/, "") || "/"

/** Said as a whole address, which is what anything cataloguing a page expects. */
const absolute = (path: string): string => new URL(path, Astro.site).href
const title = heading === undefined ? words.title : `${heading} — choai`
const at = (path: string): string => (ja ? `/ja${path}` : path)

/**
 * The same page in the other language, rather than its front page. Someone
 * reading the terms who switches wants the terms, not to start again.
 */
const other = ja ? inEnglish : `/ja${inEnglish}`
---

<!doctype html>
<html lang={words.lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={words.description} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="theme-color" content="#000031" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={words.description} />
    <meta property="og:type" content="website" />
    {/* One address for a page that answers to two: the host serves both
        spellings of a path, which is two addresses for one page as far as
        anything cataloguing it is concerned. */}
    <link rel="canonical" href={absolute(here)} />
    <link rel="alternate" hreflang="en" href={absolute(inEnglish)} />
    <link rel="alternate" hreflang="ja" href={absolute(`/ja${inEnglish}`)} />
    <link rel="alternate" hreflang="x-default" href={absolute(inEnglish)} />
  </head>
  <body>
    <main>
      <header>
        <img src="/favicon.svg" alt="" width="56" height="56" />
        <a class="home" href={at("/")}><strong>choai</strong></a>
        <a class="switch" href={other}>{words.other.label}</a>
      </header>

      <slot />

      <footer>
        <p><strong>{words.licenceHeading}</strong></p>
        <p>{words.licence}</p>
        <p>{words.builtWith}</p>
        <nav>
          <a href={SOURCE} rel="noreferrer">{words.sourceTitle}</a>
          <a href={at("/terms/")}>{words.termsTitle}</a>
          <a href={at("/privacy/")}>{words.privacyTitle}</a>
        </nav>
      </footer>
    </main>
  </body>
</html>
