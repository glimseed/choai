---
/**
 * The front page: what the app is, to somebody who has not opened it.
 */
import Shell from "./Shell.astro"
import type { Words } from "./words"

const { words } = Astro.props as { words: Words }
const HLEDGER = "https://hledger.org"
/**
 * Where the app is. Development points at the one on this machine, a build at
 * the published one, and PUBLIC_APP overrides either — so a fresh clone needs
 * no settings file to link to the right place.
 */
const APP =
  import.meta.env.PUBLIC_APP ??
  (import.meta.env.DEV ? "http://localhost:8396" : "https://hledger-pwa.dev")
---

<Shell words={words}>
  <h1>{words.tagline}</h1>
  <p class="lead">{words.lead}</p>

  <div class="ways">
    <a class="button" href={APP}>{words.open}</a>
    <a class="quiet" href={HLEDGER} rel="noreferrer">{words.aboutHledger} →</a>
  </div>

  <ul class="points">
    {
      words.points.map((point) => (
        <li>
          <h2>{point.heading}</h2>
          <p>{point.body}</p>
        </li>
      ))
    }
  </ul>
</Shell>
